    "culori": "4.0.2",
    "d3-force": "3.0.0",
    "d3-geo": "3.1.1",
    "d3-hierarchy": "3.1.2",
    "esbuild": "0.28.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-img-mapper": "2.0.2",
    "vega": "6.4.0",
    "vega-lite": "6.4.3",
