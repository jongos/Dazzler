{
  "name": "dazzler-maintenance",
  "version": "0.29.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:colors": "node tools/build_colors.mjs",
    "test:colors": "node --test tests/colors.test.mjs",
    "build:visualization": "node tools/build_visualization.mjs",
    "test:visualization": "node --test tests/visualization.test.mjs",
    "build:hotspots": "node tools/build_hotspots.mjs",
    "test:hotspots": "node --test tests/hotspots.test.mjs",
    "test": "node tools/run_tests.mjs",
    "build": "node tools/build_colors.mjs && node tools/build_visualization.mjs && node tools/build_hotspots.mjs",
    "format": "prettier --write \"tools/*.{mjs,cjs,js,css}\" \"tests/*.mjs\" \"skills/dazzler-frontend/scripts/*.{mjs,cjs,css}\"",
    "format:check": "prettier --check \"tools/*.{mjs,cjs,js,css}\" \"tests/*.mjs\" \"skills/dazzler-frontend/scripts/*.{mjs,cjs,css}\""
  },
  "devDependencies": {
    "@ankhorage/color-theory": "0.3.1",
    "@google/design.md": "0.4.0",
    "@microcharts/react": "0.19.1",
    "@svgdotjs/svg.js": "3.2.8",
    "@xmldom/xmldom": "0.9.12",
    "axe-core": "4.13.0",
    "culori": "4.0.2",
    "d3-force": "3.0.0",
    "d3-geo": "3.1.1",
    "d3-hierarchy": "3.1.2",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-img-mapper": "2.0.2",
    "vega": "6.4.0",
    "vega-lite": "6.4.3",
    "vue-img-mapper": "0.1.0"
  },
  "overrides": {
    "culori": "4.0.2"
  }
}
