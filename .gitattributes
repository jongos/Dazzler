# Font and support-file hashes are byte-exact, including upstream license line endings.
skills/dazzler-frontend/assets/fonts/** -text -whitespace
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary
skills/dazzler-frontend/scripts/vendor/** -text
skills/dazzler-frontend/references/hue3-LICENSE.txt -text
skills/dazzler-frontend/references/deslop-LICENSE.txt -text

# Preserve original documentation font notices.
docs/licenses/** -text -whitespace

# Original graphics have cataloged byte hashes.
skills/dazzler-frontend/assets/graphics/** -text -whitespace
skills/dazzler-frontend/assets/templates/** -text -whitespace
docs/templates/** -text -whitespace
*.docx binary
docs/visualizations/** -text -whitespace
docs/illustrations/** -text -whitespace
